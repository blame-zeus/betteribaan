---
import { NAV_GROUPS, OFFICIAL, SITE } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(`${href}/`));
const groupIsCurrent = (group: (typeof NAV_GROUPS)[number]) =>
  group.items.some((item) => isCurrent(item.href)) || isCurrent(group.href);
---

<header class="site-header" data-header>
  <div class="frame header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <path class="brand-stem" d="M8.5 7.5c8.2 1.1 15.1 5.1 19.5 11.8" />
        <path class="brand-leaf" d="M17.4 10.5c-5.7.2-9.4 3.4-10.9 8.4 5.8.2 9.4-2.5 10.9-8.4Z" />
        <path class="brand-fruit" d="M28 19.5c6.9 0 12.5 5.6 12.5 12.5S34.9 44.5 28 44.5 15.5 38.9 15.5 32 21.1 19.5 28 19.5Z" />
        <path class="brand-rib" d="M28 20c-3.6 4.2-5.1 9.3-4.8 14.3.2 4.2 2 7.6 4.8 10" />
        <path class="brand-rib" d="M28 20c3.6 4.2 5.1 9.3 4.8 14.3-.2 4.2-2 7.6-4.8 10" />
        <path class="brand-rib" d="M19.2 26c3.3 2 5.2 5.1 5.5 8.9M36.8 26c-3.3 2-5.2 5.1-5.5 8.9" />
        <path class="brand-rib" d="M28 19.7v-3.1M28 19.7l-2.8-2.2M28 19.7l2.8-2.2" />
      </svg>
      <span class="brand-name">Better <span>Ibaan</span></span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-menu-toggle
    >
      Menu
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      {NAV_GROUPS.map((group) => (
        <details class="nav-group" data-current={groupIsCurrent(group) ? 'true' : undefined}>
          <summary>
            <span>{group.label}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="m2.2 4.2 3.8 3.8 3.8-3.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="nav-drop">
            <p class="nav-drop-blurb">{group.blurb}</p>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    <strong>{item.label}</strong>
                    <span>{item.blurb}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      ))}
      <a class="nav-mobile-official" href={OFFICIAL.home} target="_blank" rel="noopener noreferrer">
        Official town site <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="header-actions">
      <button class="icon-button search-toggle" type="button" data-open-search aria-label="Search this guide">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="m15.5 15.5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <span class="search-label">Search</span>
      </button>

      <a class="official-link" href={OFFICIAL.home} target="_blank" rel="noopener noreferrer">
        Official site <span aria-hidden="true">↗</span>
      </a>

      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20 15.2A8.4 8.4 0 0 1 8.8 4a8.4 8.4 0 1 0 11.2 11.2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.7" />
          <path d="M12 2.4v2.2M12 19.4v2.2M2.4 12h2.2M19.4 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>
