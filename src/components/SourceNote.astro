---
import type { SourceRef } from '../data/ibaan-record';

interface Props {
  sources: SourceRef[];
  title?: string;
  note?: string;
  status?: string;
  data?: string;
  refresh?: string;
}

const { sources, title, note, status = 'Verified', data = 'Municipal and government-hosted pages', refresh = 'Updated as sources change' } = Astro.props;
const checked = sources[0]?.accessed ?? 'not checked';
const publisherList = [...new Set(sources.map((source) => source.publisher))].join(' · ');
---

<details class="source-note" data-ui>
  <summary>
    <span class="source-note-dot" aria-hidden="true"></span>
    <span class="source-note-title">
      <strong>{title ?? (sources.length === 1 ? 'Source' : `Sources · ${sources.length} references`)}</strong>
      <small>{publisherList}</small>
    </span>
    <span class="source-status">{status} · checked {checked}</span>
  </summary>
  <div class="source-note-body">
    <dl class="source-meta">
      <div><dt>Data</dt><dd>{data}</dd></div>
      <div><dt>Checked</dt><dd>{status}, {checked}</dd></div>
      <div><dt>Refresh</dt><dd>{refresh}</dd></div>
    </dl>
    {note && <p class="source-caveat"><strong>Note.</strong> {note}</p>}
    <ol class="source-links">
      {sources.map((source) => (
        <li>
          <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a>
          <span>{source.publisher} · accessed {source.accessed}</span>
        </li>
      ))}
    </ol>
  </div>
</details>
