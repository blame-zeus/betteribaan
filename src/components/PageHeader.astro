---
interface Props {
  title: string;
  intro: string;
  note?: string;
}

const { title, intro, note } = Astro.props;
---

<header class="page-head">
  <div class="frame page-head-inner">
    <h1>{title}</h1>
    <div class="page-head-copy">
      <p class="page-intro">{intro}</p>
      {note && <p class="page-note">{note}</p>}
      <slot />
    </div>
  </div>
</header>
