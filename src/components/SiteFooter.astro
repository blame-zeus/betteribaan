---
import { NAV_GROUPS, OFFICIAL, SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="frame footer-inner">
    <div class="footer-lead">
      <a class="footer-display" href="/">Iba ang Ibaan.</a>
      <p class="footer-summary">
        An independent civic guide to the public record of Ibaan, Batangas.
      </p>
    </div>

    <nav class="footer-directory" aria-label="Footer">
      {NAV_GROUPS.map((group) => (
        <section class="footer-group">
          <h2>{group.label}</h2>
          <ul>
            {group.items.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
      <section class="footer-group">
        <h2>Keep reading</h2>
        <ul>
          <li><a href="/geography">Geography and boundary map</a></li>
          <li><a href="/heritage">The Iba tree</a></li>
          <li><a href="/sitemap.xml">XML sitemap</a></li>
          <li><a href="/data/iba-an.json">Ibaan dataset</a></li>
        </ul>
      </section>
    </nav>

    <div class="footer-official">
      <h2>Official sources</h2>
      <ul>
        <li><a href={OFFICIAL.home} target="_blank" rel="noopener noreferrer">Municipality of Ibaan <span aria-hidden="true">↗</span></a></li>
        <li><a href={OFFICIAL.profile} target="_blank" rel="noopener noreferrer">General information <span aria-hidden="true">↗</span></a></li>
        <li><a href={OFFICIAL.officials} target="_blank" rel="noopener noreferrer">Elected officials <span aria-hidden="true">↗</span></a></li>
        <li><a href={OFFICIAL.bids} target="_blank" rel="noopener noreferrer">Bids and awards <span aria-hidden="true">↗</span></a></li>
      </ul>
    </div>

    <div class="footer-base">
      <p>
        <strong>{SITE.name}</strong> is an independent civic project. It is not an official website of the
        Municipality of Ibaan.
      </p>
      <p>
        Every figure is tied to a source, and gaps are marked as gaps. Photographs and boundary data are
        credited on the <a href="/sources">sources page</a>.
      </p>
      <p class="footer-top-link"><a href="#main">Back to top ↑</a><span> · {year}</span></p>
    </div>
  </div>
</footer>
