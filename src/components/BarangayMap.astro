---
import { BARANGAYS, MAP } from '../data/town';

interface Props {
  mapTitle?: string;
  mapDescription?: string;
}

const {
  mapTitle = 'The 26 barangays of Ibaan, raised by approximate mapped area',
  mapDescription = 'Approximate barangay boundaries from the PSA and NAMRIA 2023 boundary file, simplified for the web. Raised faces show mapped area, not population.',
} = Astro.props;

const bySlug = new Map(BARANGAYS.map((barangay) => [barangay.slug, barangay]));
const drawnBarangays = MAP.ibaan.drawOrder.map((slug) => bySlug.get(slug)!);
---

<section class="map-board" data-map-board aria-labelledby="barangay-map-title">
  <div class="map-stage">
    <div class="map-canvas">
      <div class="map-svg-wrap">
        <svg
          class="ibaan-map"
          viewBox={MAP.ibaan.viewBox}
          role="img"
          aria-labelledby="barangay-map-title barangay-map-desc"
        >
          <title id="barangay-map-title">{mapTitle}</title>
          <desc id="barangay-map-desc">{mapDescription}</desc>

          <g class="map-shapes">
            {drawnBarangays.map((barangay, index) => (
              <a
                class="map-shape"
                href={`/geography#barangay-${barangay.slug}`}
                data-map-shape={barangay.slug}
                data-name={barangay.name}
                data-code={barangay.code}
                aria-label={`Barangay ${barangay.name}, PSGC ${barangay.code}`}
                style={`--lift:${barangay.height};--i:${index}`}
              >
                <path class="map-base" d={barangay.path} />
                <path class="map-sides" d={barangay.sidePath} />
                <g class="map-top-lift">
                  <path class="map-outline" d={barangay.path} />
                </g>
              </a>
            ))}
          </g>

          <g class="map-compass" aria-hidden="true" transform="translate(764 -16)">
            <path d="M0 18V-12M0-12l-7 13M0-12l7 13" />
            <text x="0" y="-22">N</text>
          </g>
        </svg>
      </div>

      <div class="map-toolbar">
        <button type="button" class="map-view-toggle" data-map-3d aria-pressed="true">
          3D view
        </button>
        <p class="map-height-note">{MAP.ibaan.heightNote}</p>
      </div>

      <div class="map-readout" aria-live="polite" data-map-readout>
        <span class="map-readout-name" data-map-name>Ibaan</span>
        <span class="map-readout-code" data-map-code>{BARANGAYS.length} barangays · Batangas</span>
      </div>

      <p class="map-caption">
        Approximate boundaries · PSA/NAMRIA 2023, simplified.
        <a href="/sources">Read the map note</a>.
      </p>
    </div>

    <aside class="map-index" aria-label="Barangay index">
      <div class="map-index-head">
        <label for="barangay-filter">Find a barangay</label>
        <input
          id="barangay-filter"
          type="search"
          placeholder="Type a name"
          autocomplete="off"
          spellcheck="false"
          data-map-filter
        />
      </div>

      <p class="map-index-count" data-map-count aria-live="polite">{BARANGAYS.length} barangays</p>

      <ul class="barangay-index">
        {BARANGAYS.map((barangay) => (
          <li id={`barangay-${barangay.slug}`} data-map-row={barangay.slug}>
            <a
              href={`/geography#barangay-${barangay.slug}`}
              data-map-item={barangay.slug}
              data-name={barangay.name}
              data-code={barangay.code}
            >
              <span class="barangay-name">{barangay.name} · PSGC {barangay.code}, Ibaan, Batangas, Philippines</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="map-index-note">
        PSGC codes come from the 2023 boundary file. Hover, focus, or tap a name to find it on the map.
      </p>
    </aside>
  </div>
</section>
