---
import { BARANGAYS, MAP } from '../data/town';

interface Props {
  mapTitle?: string;
  mapDescription?: string;
}

const {
  mapTitle = 'The 26 barangays of Ibaan on an OpenStreetMap-based map',
  mapDescription = 'An interactive OpenStreetMap-style map of Ibaan with source-detailed OCHA COD-AB, NAMRIA and PSA 2023 barangay boundaries overlaid.',
} = Astro.props;
---

<section class="map-board" data-map-board aria-labelledby="barangay-map-title">
  <div class="map-stage">
    <div class="map-canvas">
      <div class="map-viewport">
        <div class="map-svg-wrap" data-map-fallback>
          <svg
            class="ibaan-map"
            viewBox={MAP.ibaan.viewBox}
            role="img"
            aria-labelledby="barangay-map-title barangay-map-desc"
          >
            <title id="barangay-map-title">{mapTitle}</title>
            <desc id="barangay-map-desc">{mapDescription}</desc>

            <g class="map-shapes">
              {BARANGAYS.map((barangay, index) => (
                <a
                  class="map-shape"
                  href={`/geography#barangay-${barangay.slug}`}
                  data-map-shape={barangay.slug}
                  data-name={barangay.name}
                  data-code={barangay.code}
                  aria-label={`Barangay ${barangay.name}, boundary code ${barangay.code}`}
                  style={`--i:${index}`}
                >
                  <path class="map-outline" d={barangay.path} />
                </a>
              ))}
            </g>

            <g class="map-labels" aria-hidden="true">
              {BARANGAYS.filter((barangay) => barangay.showLabel).map((barangay) => (
                <text x={barangay.label.x} y={barangay.label.y}>{barangay.name}</text>
              ))}
            </g>

            <g class="map-compass" aria-hidden="true" transform="translate(764 40)">
              <path d="M0 18V-12M0-12l-7 13M0-12l7 13" />
              <text x="0" y="-22">N</text>
            </g>
          </svg>
        </div>

        <div class="map-canvas-gl" data-map-canvas data-ui aria-hidden="true" inert></div>

        <p class="map-status" data-map-status data-ui role="status" aria-live="polite" hidden></p>
      </div>

      <div class="map-toolbar" data-map-ui data-ui hidden>
        <button type="button" class="map-view-toggle" data-map-3d aria-pressed="true">
          3D view
        </button>
        <button type="button" class="map-reset" data-map-reset>Reset view</button>
        <p class="map-view-note">
          3D shows OpenStreetMap terrain and buildings. Height is not a data value.
        </p>
      </div>

      <div class="map-readout" aria-live="polite" data-map-readout>
        <span class="map-readout-name" data-map-name>Ibaan</span>
        <span class="map-readout-code" data-map-code>{BARANGAYS.length} barangays · Batangas</span>
      </div>

      <p class="map-caption" data-ui>
        Basemap © OpenStreetMap contributors · tiles by OpenFreeMap. Boundary outlines follow the
        OCHA COD-AB / NAMRIA / PSA 2023 source shapes. <a href="/sources">Map sources</a>.
      </p>
    </div>

    <aside class="map-index" aria-label="Barangay index">
      <div class="map-index-head">
        <label for="barangay-filter">Find a barangay</label>
        <input
          id="barangay-filter"
          type="search"
          placeholder="Type a name"
          autocomplete="off"
          spellcheck="false"
          data-map-filter
        />
      </div>

      <p class="map-index-count" data-map-count aria-live="polite">{BARANGAYS.length} barangays</p>

      <ul class="barangay-index">
        {BARANGAYS.map((barangay) => (
          <li id={`barangay-${barangay.slug}`} data-map-row={barangay.slug}>
            <a
              href={`/geography#barangay-${barangay.slug}`}
              data-map-item={barangay.slug}
              data-name={barangay.name}
              data-code={barangay.code}
            >
              <span class="barangay-name">{barangay.name} · boundary code {barangay.code}, Ibaan, Batangas, Philippines</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="map-index-note" data-ui>
        Boundary codes come from the 2023 boundary file. Hover, focus, or tap a name to find it on the map.
      </p>
    </aside>
  </div>
</section>
