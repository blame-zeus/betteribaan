---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BarangayMap from '../components/BarangayMap.astro';
import BatangasMap from '../components/BatangasMap.astro';
import { HERO_FACTS, NEIGHBOURS, PUBLIC_RECORD, TOWN } from '../data/town';
import { NAV_GROUPS, OFFICIAL, SITE } from '../lib/site';

import heroPhoto from '../assets/images/ben-r-medrano-plaza-ibaan-batangas-2026.jpg';
import ibaTree from '../assets/images/iba-tree-ibaan.webp';
import churchPhoto from '../assets/images/st-james-the-greater-shrine-parish-ibaan.jpg';
import goodFridayPhoto from '../assets/images/good-friday-procession-in-ibaan-batangas-2023.jpg';
import panuluyanPhoto from '../assets/images/panuluyan-sa-ibaan-batangas-2023-12-24.jpg';
import streetPhoto from '../assets/images/j-pastor-street-ibaan-batangas-2026.jpg';

const gallery = [
  {
    image: churchPhoto,
    alt: 'The facade of St. James the Greater Shrine-Parish in Ibaan',
    caption: 'St. James the Greater Shrine-Parish',
    meta: 'LMP 2001 · CC BY-SA 4.0',
  },
  {
    image: goodFridayPhoto,
    alt: 'A Good Friday procession through Ibaan',
    caption: 'Good Friday procession, 2023',
    meta: 'LMP 2001 · CC BY-SA 4.0',
  },
  {
    image: panuluyanPhoto,
    alt: 'A Panuluyan procession in Ibaan',
    caption: 'Panuluyan, 2023',
    meta: 'LMP 2001 · CC BY-SA 4.0',
  },
  {
    image: streetPhoto,
    alt: 'J. Pastor Street in Ibaan',
    caption: 'J. Pastor Street, 2026',
    meta: 'Ralff Nestor Nacor · CC BY-SA 4.0',
  },
];
---

<Base title="Iba ang Ibaan." description={SITE.description}>
  <section class="hero">
    <div class="frame">
      <div class="hero-panel">
        <div class="hero-head">
          <h1 class="hero-title">
            <span>Iba ang</span>
            <span>Ibaan.</span>
          </h1>
        </div>

        <div class="hero-foot">
          <div class="hero-copy">
            <p class="hero-standfirst">
              A sourced field guide to Ibaan: 26 barangays, its boundary, and the Iba tree.
            </p>
            <div class="hero-actions">
              <a class="btn" href="#barangays">Explore the barangays</a>
              <a class="text-link" href="/heritage">Read the Iba tree entry <span aria-hidden="true">→</span></a>
            </div>
            <p class="hero-source">
              Facts: the Municipality of Ibaan profile, using 2020 census figures.
              <a href="/sources">Figure notes</a>.
            </p>
          </div>

          <figure class="hero-figure">
            <div class="hero-figure-image">
              <Image
                src={heroPhoto}
                alt="Ben R. Medrano Plaza in Ibaan, Batangas"
                widths={[640, 900, 1200]}
                sizes="(max-width: 48rem) 100vw, 36vw"
                format="webp"
                quality={82}
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <figcaption>
              <span>Ben R. Medrano Plaza, Ibaan</span>
              <span>Ralff Nestor Nacor · CC BY-SA 4.0</span>
            </figcaption>
          </figure>
        </div>

        <dl class="hero-facts">
          {HERO_FACTS.map((fact) => (
            <div>
              <dt>{fact.value}</dt>
              <dd>{fact.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="frame">
      <div class="section-head">
        <h2>Browse the whole guide.</h2>
        <div class="section-copy">
          <p>
            Six sections cover the public record: services, government, statistics, transparency,
            and the sources behind them. Every figure stays tied to its page.
          </p>
        </div>
      </div>
      <div class="nav-card-grid">
        {NAV_GROUPS.map((group) => (
          <a class="nav-card" href={group.href}>
            <strong>{group.label}</strong>
            <span>{group.blurb}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section map-section" id="barangays">
    <div class="frame">
      <div class="section-head">
        <h2>Twenty-six barangays, one town.</h2>
        <div class="section-copy">
          <p>
            Ibaan is a second-class municipality in Batangas. Approximate PSA and NAMRIA boundaries
            sit over an OpenStreetMap-based map. Switch between a flat view and a tilted 3D view of
            terrain and buildings.
          </p>
          <p class="section-link"><a href="/geography">Open the geography guide <span aria-hidden="true">→</span></a></p>
        </div>
      </div>
      <BarangayMap />
    </div>
  </section>

  <section class="section heritage-section">
    <div class="frame">
      <div class="heritage-grid">
        <figure class="heritage-figure">
          <Image
            src={ibaTree}
            alt="The Iba tree in Ibaan"
            widths={[480, 720]}
            sizes="(max-width: 60rem) 90vw, 40vw"
            format="webp"
            quality={85}
            loading="lazy"
          />
          <figcaption>
            <span>The Iba tree in Ibaan, Batangas, from the municipal heritage page.</span>
            <span>Municipality of Ibaan · <a href={OFFICIAL.ibaTree} target="_blank" rel="noopener noreferrer">heritage page <span aria-hidden="true">↗</span></a></span>
          </figcaption>
        </figure>

        <div class="heritage-copy">
          <h2>A town named for a tree.</h2>
          <p class="heritage-intro">
            The municipal heritage page records an Iba that was once abundant here, became a
            symbol of the town, and is now locally rare. Its fruit is sharply sour and belongs in
            the local kitchen.
          </p>

          <dl class="heritage-list">
            <div>
              <dt>In the kitchen</dt>
              <dd>Souring agent for fish, and the base for vinegar, wine, and sweets soaked in limewater.</dd>
            </div>
            <div>
              <dt>In the landscape</dt>
              <dd>Few old trees remain. The page notes that the Iba is not found in neighbouring towns.</dd>
            </div>
            <div>
              <dt>In the barangays</dt>
              <dd>A municipal planting programme has reached every barangay, with <span lang="fil">Iba-lik ang Kasaysayan</span> as its local heritage project.</dd>
            </div>
          </dl>

          <p class="heritage-link">
            <a class="text-link" href="/heritage">Read the full Iba profile <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section context-section">
    <div class="frame context-grid">
      <div class="context-copy">
        <h2>Five neighbours.</h2>
        <p class="context-intro">
          Ibaan sits at {TOWN.coordinates.dms}, about {TOWN.distanceToBatangasCityKm} kilometres
          from Batangas City. Its {TOWN.landAreaKm2} square kilometres make up
          {TOWN.landAreaShare}% of the province.
        </p>

        <ul class="neighbour-list">
          {NEIGHBOURS.map((place) => (
            <li>
              <span>{place.name}</span>
              <span>{place.direction}</span>
            </li>
          ))}
        </ul>

        <p class="context-link"><a href="/geography">See the boundary notes <span aria-hidden="true">→</span></a></p>
      </div>

      <div class="context-map-wrap">
        <BatangasMap />
      </div>
    </div>
  </section>

  <section class="section gallery-section">
    <div class="frame">
      <div class="section-head">
        <h2>The town, in ordinary light.</h2>
        <div class="section-copy">
          <p>
            A church, a procession, a street, a plaza. These are photographs of Ibaan, not
            stand-ins for somewhere else.
          </p>
        </div>
      </div>

      <div class="photo-strip">
        {gallery.map((photo) => (
          <figure>
            <div class="photo-strip-image">
              <Image
                src={photo.image}
                alt={photo.alt}
                widths={[320, 520, 760]}
                sizes="(max-width: 48rem) 50vw, 24vw"
                format="webp"
                quality={80}
                loading="lazy"
              />
            </div>
            <figcaption>
              <span>{photo.caption}</span>
              <span>{photo.meta}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <p class="photo-credit">
        Photographs from Wikimedia Commons. <a href="/sources">Full credits and licences →</a>
      </p>
    </div>
  </section>

  <section class="public-record">
    <div class="frame">
      <div class="record-panel">
        <div class="record-lead">
          <h2>The public record.</h2>
          <p>
            Official pages can change without notice. These links go to the Municipality of Ibaan,
            not to a copy made here.
          </p>
        </div>

        <ul class="record-list">
          {PUBLIC_RECORD.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                <span class="record-title">{item.title}</span>
                <span class="record-copy">{item.copy}</span>
                <span class="record-meta">{item.meta} <span aria-hidden="true">↗</span></span>
              </a>
            </li>
          ))}
        </ul>

        <p class="record-note">
          Looking for the map files? <a href="/data/iba-an.json">Download the open data</a> or read
          <a href="/sources">how the figures and boundaries were checked</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
