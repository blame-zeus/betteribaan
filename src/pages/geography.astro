---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BarangayMap from '../components/BarangayMap.astro';
import BatangasMap from '../components/BatangasMap.astro';
import { BARANGAYS, MAP, NEIGHBOURS, TOWN } from '../data/town';
import { formatNumber } from '../lib/format';

import plazaPhoto from '../assets/images/ben-r-medrano-plaza-ibaan-batangas-2026.jpg';
import streetPhoto from '../assets/images/j-pastor-street-ibaan-batangas-2026.jpg';
import churchPhoto from '../assets/images/st-james-the-greater-shrine-parish-ibaan.jpg';
import grottoPhoto from '../assets/images/ibaan-church-grotto-2026.jpg';

const gallery = [
  {
    image: plazaPhoto,
    alt: 'Ben R. Medrano Plaza in Ibaan, Batangas',
    caption: 'Ben R. Medrano Plaza, 2026',
    meta: 'Ralff Nestor Nacor · CC BY-SA 4.0',
  },
  {
    image: streetPhoto,
    alt: 'J. Pastor Street in Ibaan, Batangas',
    caption: 'J. Pastor Street, 2026',
    meta: 'Ralff Nestor Nacor · CC BY-SA 4.0',
  },
  {
    image: churchPhoto,
    alt: 'St. James the Greater Shrine-Parish in Ibaan, Batangas',
    caption: 'St. James the Greater Shrine-Parish, 2023',
    meta: 'LMP 2001 · CC BY-SA 4.0',
  },
  {
    image: grottoPhoto,
    alt: 'The grotto beside the church in Ibaan, Batangas',
    caption: 'Ibaan Church Grotto, 2026',
    meta: 'Ralff Nestor Nacor · CC BY-SA 4.0',
  },
];
---

<Base
  title="Geography"
  description="Ibaan’s 26 barangays, its boundary, its five neighbours, and notes on the map."
  crumbs={[{ label: 'Geography' }]}
>
  <PageHeader
    title="A small town, drawn plainly."
    intro="Ibaan is one of the municipalities of Batangas, with 26 barangays and a boundary it shares with five neighbours. This page keeps the map and the caveats together."
    note="Official figures below come from the Municipality of Ibaan’s profile. The barangay map uses OpenStreetMap tiles and source-detailed boundaries; it is an orientation map, not a survey."
  />

  <section class="section-tight">
    <div class="frame">
      <dl class="stats-grid">
        <div>
          <dt>{formatNumber(TOWN.population)}</dt>
          <dd>residents, 2020 census</dd>
        </div>
        <div>
          <dt>{formatNumber(TOWN.households)}</dt>
          <dd>households, 2020 census</dd>
        </div>
        <div>
          <dt>{TOWN.barangayCount}</dt>
          <dd>barangays</dd>
        </div>
        <div>
          <dt>{TOWN.landAreaKm2}</dt>
          <dd>square kilometres</dd>
        </div>
        <div>
          <dt>{TOWN.landAreaShare}%</dt>
          <dd>of Batangas land area</dd>
        </div>
        <div>
          <dt>{TOWN.distanceToBatangasCityKm} km</dt>
          <dd>from Batangas City</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section map-section" id="barangays">
    <div class="frame">
      <div class="section-head">
        <h2>The 26 barangays.</h2>
        <div class="section-copy">
          <p>
            The map overlays OCHA COD-AB boundaries from NAMRIA and PSA on OpenStreetMap data. The
            outlines keep their source vertex detail, so they follow the mapped barangay shapes.
            They are for orientation only. Switch between flat and 3D views; height on the map shows
            terrain and buildings, not figures.
          </p>
          <p class="section-link"><a href="#boundary-notes">Skip to the boundary notes <span aria-hidden="true">→</span></a></p>
        </div>
      </div>
      <BarangayMap />
    </div>
  </section>

  <section class="section-tight">
    <div class="frame">
      <div class="table-head">
        <h2>Ibaan, in four frames.</h2>
        <p>Verified photographs of places in Ibaan, away from the diagrams and the boundary lines.</p>
      </div>
      <div class="photo-strip geography-photos">
        {gallery.map((photo) => (
          <figure>
            <div class="photo-strip-image">
              <Image
                src={photo.image}
                alt={photo.alt}
                widths={[280, 560, 840]}
                sizes="(max-width: 40rem) 46vw, (max-width: 64rem) 30vw, 20vw"
                format="webp"
                loading="lazy"
              />
            </div>
            <figcaption>
              <span>{photo.caption}</span>
              <span>{photo.meta}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="photo-credit">
        Photographs from Wikimedia Commons. <a href="/sources">Full credits and licences →</a>
      </p>
    </div>
  </section>

  <section class="section-tight list-section">
    <div class="frame">
      <div class="table-head">
        <h2>Barangay list</h2>
        <p>
          Boundary codes are carried from the same 2023 map file. They are not presented as verified
          PSGC codes. Names are listed alphabetically.
        </p>
      </div>
      <div class="table-wrap">
        <table>
          <caption class="visually-hidden">The 26 barangays of Ibaan, Batangas, with map boundary codes</caption>
          <thead>
            <tr>
              <th scope="col">Barangay</th>
              <th scope="col">Boundary code</th>
            </tr>
          </thead>
          <tbody>
            {BARANGAYS.map((barangay) => (
              <tr id={`barangay-${barangay.slug}`}>
                <th scope="row">{barangay.name}</th>
                <td><code>{barangay.code}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        The mapped barangay polygons sum to about 70.35 km², while the municipal profile gives
        68.99 km². The difference comes from the boundary source; the official land area is the
        figure used on this site.
      </p>
    </div>
  </section>

  <section class="section context-section">
    <div class="frame context-grid">
      <div class="context-copy">
        <h2>Where Ibaan sits.</h2>
        <p class="context-intro">
          The municipality is at {TOWN.coordinates.dms}. The municipal profile places it
          {TOWN.distanceToBatangasCityKm} kilometres from Batangas City and names five neighbours.
        </p>

        <dl class="neighbour-ledger">
          {NEIGHBOURS.map((place) => (
            <div>
              <dt>{place.direction}</dt>
              <dd>{place.name}</dd>
            </div>
          ))}
        </dl>

        <p class="context-note">
          Directions follow the municipal profile. The Batangas context map uses a simplified
          PSA/NAMRIA file; the local barangay map uses the detailed boundary outlines.
        </p>
      </div>

      <div class="context-map-wrap">
        <BatangasMap />
      </div>
    </div>
  </section>

  <section class="section-tight" id="boundary-notes">
    <div class="frame">
      <div class="note-panel">
        <h2>Boundary notes</h2>
        <div class="note-grid">
          <div>
            <h3>Approximate, not surveyed</h3>
            <p>
              The local outlines keep their source vertex detail, but they are still administrative
              boundaries. They do not settle property lines, barangay jurisdiction, or any legal
              boundary question.
            </p>
          </div>
          <div>
            <h3>Two map scales</h3>
            <p>
              The barangay map is a local view of Ibaan. The Batangas map is a provincial
              orientation view. Neither map uses a survey-grade projection or a printed scale bar.
            </p>
          </div>
          <div>
            <h3>Source</h3>
            <p>
              OCHA COD-AB boundaries from NAMRIA and PSA, released 2023-11-06 and redistributed with
              PSGC codes by
              <a href={MAP.source.barangaysUrl} target="_blank" rel="noopener noreferrer">faeldon/philippines-psgc-shapefiles</a>.
              Upstream data is CC BY-IGO 3.0; the redistribution wrapper is MIT.
            </p>
          </div>
          <div>
            <h3>Official land area</h3>
            <p>
              Use the municipal profile’s {TOWN.landAreaKm2} km² figure for the town’s land area.
              The map geometry is not a replacement for it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
