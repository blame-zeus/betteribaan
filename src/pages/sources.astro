---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Toc from '../components/Toc.astro';
import SourceNote from '../components/SourceNote.astro';
import GapPanel from '../components/GapPanel.astro';
import { CREDITS, FIGURE_NOTES, MAP, SOURCE_GROUPS, TOWN } from '../data/town';
import { GAPS, SOURCE, VERIFIED_ON } from '../data/ibaan-record';
import { OFFICIAL } from '../lib/site';

const registry = Object.values(SOURCE);
---

<Base
  title="Sources and credits"
  description="Official Ibaan sources, checked dates, map data, image credits, and unresolved figures."
  crumbs={[{ label: 'Sources' }]}
>
  <PageHeader
    title="Sources, credits, and the figures left out."
    intro="A civic guide is only as good as its paper trail. This page records where the facts, maps, and photographs come from, and where the official record disagrees with itself."
    note={`Checked ${VERIFIED_ON}. The checked date is not the same as a source's own as-of date.`}
  >
    <Toc
      items={[
        { id: 'figure-notes', label: 'Figure notes' },
        { id: 'registry', label: 'Source registry' },
        { id: 'source-groups', label: 'Source groups' },
        { id: 'map', label: 'Map generation' },
        { id: 'credits', label: 'Photograph credits' },
        { id: 'gaps', label: 'Open gaps' },
      ]}
    />
  </PageHeader>

  <section class="section-tight" id="figure-notes">
    <div class="frame">
      <div class="section-head">
        <h2>Two figures not published here.</h2>
        <div class="section-copy">
          <p>
            The Municipality of Ibaan publishes two profile pages. They do not agree on elevation or
            on the distance to Manila. Rather than choose one silently, this guide leaves both out.
          </p>
        </div>
      </div>
      <div class="figure-notes">
        {FIGURE_NOTES.map((note) => (
          <div>
            <h3>{note.title}</h3>
            <p>{note.copy}</p>
          </div>
        ))}
      </div>
      <p class="table-note">
        The distance to Batangas City, {TOWN.distanceToBatangasCityKm} kilometres, appears in the
        municipal profile and does not conflict across the two pages. It is the only distance figure
        used on this site.
      </p>
    </div>
  </section>

  <section class="section-tight" id="registry">
    <div class="frame">
      <SourceNote
        sources={[SOURCE.profile, SOURCE.officials, SOURCE.bids, SOURCE.cmci, SOURCE.hotlines]}
        title="Primary registry"
        data="Municipal pages and the DTI CMCI profile"
        note="Each page on this site carries its own source note. This registry is the common index."
        refresh="Re-check monthly or after a municipal site update"
      />
      <div class="table-wrap">
        <table class="data-table">
          <caption class="visually-hidden">Source registry for Better Ibaan</caption>
          <thead>
            <tr>
              <th scope="col">Source</th>
              <th scope="col">Publisher</th>
              <th scope="col">Checked</th>
            </tr>
          </thead>
          <tbody>
            {registry.map((source) => (
              <tr>
                <th scope="row">
                  <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a>
                </th>
                <td>{source.publisher}</td>
                <td class="num">{source.accessed}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-tight" id="source-groups">
    <div class="frame">
      <div class="section-head">
        <h2>The source groups.</h2>
        <div class="section-copy">
          <p>
            Every factual claim on this site should be traceable to one of these groups. If you find
            something that is not, treat it as a mistake and check the official page.
          </p>
        </div>
      </div>
      <div class="source-groups">
        {SOURCE_GROUPS.map((group) => (
          <section>
            <h3>{group.title}</h3>
            <p>{group.note}</p>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <div class="directory-grid">
        <div class="directory-card">
          <h3>Official home</h3>
          <p class="card-meta">Municipality of Ibaan</p>
          <a href={OFFICIAL.home} target="_blank" rel="noopener noreferrer">Open the site <span aria-hidden="true">↗</span></a>
        </div>
        <div class="directory-card">
          <h3>Archives</h3>
          <p class="card-meta">Announcements and events</p>
          <a href={OFFICIAL.announcements} target="_blank" rel="noopener noreferrer">Open announcements <span aria-hidden="true">↗</span></a>
        </div>
        <div class="directory-card">
          <h3>Datasets</h3>
          <p class="card-meta">Static JSON with provenance</p>
          <a href="/data">Open the catalogue <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" id="map">
    <div class="frame">
      <div class="note-panel">
        <h2>Map generation</h2>
        <div class="note-grid">
          <div>
            <h3>Source</h3>
            <p>
              PSA/NAMRIA 2023 administrative boundaries, published in the
              <a href={MAP.source.barangays} target="_blank" rel="noopener noreferrer">barangay-boundaries-repository</a>.
              The repository is MIT-licensed.
            </p>
          </div>
          <div>
            <h3>Simplification</h3>
            <p>
              The boundary file is published at roughly 500-metre simplification. It is suitable for
              orientation, but not for measuring land, settling jurisdiction, or drawing a legal
              boundary.
            </p>
          </div>
          <div>
            <h3>Interactive map</h3>
            <p>
              The 26 barangay polygons are overlaid on OpenStreetMap data served by OpenFreeMap.
              The 3D view also requests terrain and building data. No figure on this site is encoded
              in the height of the map.
            </p>
          </div>
          <div>
            <h3>Flat fallback</h3>
            <p>
              If WebGL or the tile services are unavailable, the page keeps a plain SVG outline of
              the same 26 barangays. The flat view is also one click away in the map toolbar.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" id="credits">
    <div class="frame">
      <div class="section-head">
        <h2>Photograph credits.</h2>
        <div class="section-copy">
          <p>
            The photographs are of Ibaan. The Iba tree photograph comes from the municipality’s
            heritage page; the rest are Creative Commons photographs from Wikimedia Commons.
          </p>
        </div>
      </div>
      <ul class="credit-list">
        {CREDITS.map((credit) => (
          <li>
            <span class="credit-title">{credit.title}</span>
            <span class="credit-meta">{credit.creator} · {credit.license} · {credit.via}</span>
            <a href={credit.href} target="_blank" rel="noopener noreferrer">View the source <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" id="gaps">
    <div class="frame">
      <GapPanel
        items={GAPS}
        title="Where the record stops"
        intro="These fields are not in the guide or its datasets. Each line names the best public page to check next."
      />
    </div>
  </section>
</Base>
