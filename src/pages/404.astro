---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { NAV_GROUPS } from '../lib/site';
---

<Base
  title="Page not found"
  description="That page is not part of the Ibaan field guide."
  noindex
>
  <PageHeader
    title="That page is not on the map."
    intro="The address may have changed, or the page may never have existed. The guide is grouped into six sections, and every one of them starts below."
  />

  <section class="section-tight">
    <div class="frame">
      <div class="nav-card-grid">
        {NAV_GROUPS.map((group) => (
          <a class="nav-card" href={group.href}>
            <strong>{group.label}</strong>
            <span>{group.blurb}</span>
          </a>
        ))}
      </div>
      <p class="table-note">
        The full route list is on the <a href="/sitemap">sitemap</a>. The
        <a href="/barangays">barangay map</a> is also a good place to restart.
      </p>
    </div>
  </section>
</Base>
