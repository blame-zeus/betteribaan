---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base
  title="Page not found"
  description="That page is not part of the Ibaan field guide."
  noindex
>
  <PageHeader
    title="That page is not on the map."
    intro="The address may have changed, or the page may never have existed. The barangay map and the town guide are the best places to restart."
  />

  <section class="section-tight">
    <div class="frame">
      <div class="not-found-actions">
        <a class="btn" href="/">Return to Iba ang Ibaan</a>
        <a class="text-link" href="/geography">Open the geography guide <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>
